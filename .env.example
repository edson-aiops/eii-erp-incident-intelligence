# ===========================================
# SmartRouter-EII - Configuration Template
# ===========================================
# Copie este arquivo para .env e preencha com seus valores

# Groq Configuration (Free Tier)
QWEN_API_KEY=gsk_your-groq-api-key-here
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_MODEL=llama-3.1-8b-instant

# Feature Flags
EII_USE_QWEN_SUPERVISOR=true
EII_QWEN_PRIORITY=cost
EII_RETRIEVAL_BACKEND=chromadb
EII_LOG_LEVEL=INFO