# ===========================================
# EII ERP Incident Intelligence - Configuration Template
# ===========================================
# Copy this file to .env and fill in your values.
# OR use Windows Credential Manager: python secure_secrets.py set KEY VALUE
# NEVER commit real secrets or the .env file.

# --- LLM Providers (at least 1 required) ---
GROQ_API_KEY=gsk_your-groq-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
MISTRAL_API_KEY=your-mistral-key-here
CEREBRAS_API_KEY=your-cerebras-key-here
GOOGLE_AI_API_KEY=your-google-key-here
OPENAI_API_KEY=sk-your-openai-key-here
MOONSHOT_API_KEY=your-moonshot-key-here
QWEN_API_KEY=gsk_your-groq-key-here

# --- Provider-specific overrides (optional) ---
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# QWEN_BASE_URL=https://api.groq.com/openai/v1
# QWEN_MODEL=llama-3.1-8b-instant

# --- Local Auth (app.py) ---
EII_ADMIN_USER=seu.usuario
EII_ADMIN_PASS=sua-senha-segura
EII_API_KEY=sua-api-key-rest

# --- E-mail HITL alerts (optional) ---
EII_SMTP_HOST=smtp.gmail.com
EII_SMTP_PORT=587
EII_SMTP_USER=seu-email@gmail.com
EII_SMTP_PASS=sua-senha-app
EII_ALERT_EMAIL=analista@empresa.com

# --- Retrieval Backend ---
EII_RETRIEVAL_BACKEND=chromadb
# QDRANT_URL=https://seu-cluster.qdrant.io
# QDRANT_API_KEY=your-qdrant-key

# --- CRAG model overrides (optional) ---
# EII_MODEL_ROUTER=llama-3.1-8b-instant
# EII_MODEL_GENERATOR=llama-3.3-70b-versatile

# --- Observability (optional) ---
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=eii-production
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=eii-erp-v2
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_TRACING_V2=true

# --- LGPD / Ollama Local (optional) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma4:26b
# OLLAMA_API_KEY=ollama
# LGPD_MODE=true

# --- Persistence ---
# DB_PATH=eii_incidents.db

# --- Integrations (optional) ---
# RAGFLOW_API_KEY=your-ragflow-key
# RAGFLOW_DATASET_ID=your-dataset-id
# HF_TOKEN=your-huggingface-token

# --- Feature Flags ---
EII_LOG_LEVEL=INFO

# A26 - Audit log PostgreSQL (opcional; pipeline tolera indisponibilidade)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eii
POSTGRES_USER=eii
POSTGRES_PASSWORD=your_password
